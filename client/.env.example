# API URL - your backend API base URL (without trailing slash)
# The Socket.IO URL is derived from this by stripping "/api".
#
# Options:
#   1. ngrok tunnel:  VITE_API_URL=https://your-ngrok-url.ngrok-free.dev/api
#   2. Local direct:  VITE_API_URL=http://localhost:5000/api
#   3. Vite proxy:    VITE_API_URL=/api  (uses the proxy in vite.config.js)
VITE_API_URL=https://your-ngrok-url.ngrok-free.dev/api
