# Server Configuration
PORT=5000

# MongoDB Connection String - Set your connection string here
# Example: mongodb://localhost:27017/mern-chat
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mern-chat
MONGODB_URI=mongodb://localhost:27017/mern-chat

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Client URL for CORS - comma-separated list of allowed origins
# Include your Vercel frontend URL and local dev URL
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# ngrok URL (for reference)
NGROK_URL=https://your-ngrok-url.ngrok-free.dev

# Environment
NODE_ENV=development
